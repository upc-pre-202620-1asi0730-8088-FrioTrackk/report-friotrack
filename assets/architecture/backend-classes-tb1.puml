@startuml
title FrioTrack DDD tactical model - target design
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
left to right direction
note as Scope
Target design. TB1 uses an implemented supporting API with a JSON store.
Typed DDD aggregates, EF Core and relational transactions remain planned.
Core and supporting contexts precede generic IAM.
end note
package "Shipment Management [Core]" {
class Shipment <<AggregateRoot>> {
  - range: ThermalRange
  - id: UUID
  - code: String
  - organizationId: UUID
  - coordinatorId: UUID
  - clientId: UUID
  - cargo: String
  - weightTons: Decimal
  - origin: String
  - destination: String
  - plannedDeparture: DateTimeOffset
  - estimatedArrival: DateTimeOffset
  - status: ShipmentStatus
  - version: Int64
  + schedule(resources, client): void
  + startTransit(): void
  + markDelivered(): void
  + cancel(reason: String): void
  + updateRange(range: ThermalRange): void
}
interface IShipmentRepository <<DomainPort>> {
  + find(id): Shipment
  + save(aggregate: Shipment): void
}
IShipmentRepository ..> Shipment : persists root
class ShipmentHistoryEvent <<Entity>> {
  - id: UUID
  - shipmentId: UUID
  - actorId: UUID
  - action: String
  - fromStatus: String?
  - toStatus: String?
  - note: String
  - recordedAt: DateTimeOffset
}
class ThermalRange <<ValueObject>> {
  - minTempC: Decimal
  - maxTempC: Decimal
  - minHumidityPct: Decimal
  - maxHumidityPct: Decimal
  - toleranceMinutes: Integer
  + contains(temperatureC, humidityPct): Boolean
}
}
package "Monitoring and Telemetry [Core]" {
class ShipmentMonitoring <<AggregateRoot>> {
  - range: MonitoredRange
  - id: UUID
  - shipmentId: UUID
  - maxSilenceMinutes: Integer
  - signalStatus: SignalStatus
  - lastReadingAt: DateTimeOffset?
  - startedAt: DateTimeOffset
  - stoppedAt: DateTimeOffset?
  + start(range: MonitoredRange): void
  + recordReading(reading): void
  + detectCommunicationGap(at): void
  + stop(at: DateTimeOffset): void
}
interface IShipmentMonitoringRepository <<DomainPort>> {
  + find(id): ShipmentMonitoring
  + save(aggregate: ShipmentMonitoring): void
}
IShipmentMonitoringRepository ..> ShipmentMonitoring : persists root
class SensorReading <<Entity>> {
  - id: Int64
  - monitoringId: UUID
  - temperatureC: Decimal
  - humidityPct: Decimal
  - withinBothRanges: Boolean
  - recordedAt: DateTimeOffset
  + evaluate(range: ThermalRange): Boolean
}
class PositionReport <<Entity>> {
  - id: Int64
  - monitoringId: UUID
  - latitude: Decimal
  - longitude: Decimal
  - recordedAt: DateTimeOffset
}
class MonitoredRange <<ValueObject>> {
  - minTempC: Decimal
  - maxTempC: Decimal
  - minHumidityPct: Decimal
  - maxHumidityPct: Decimal
  - toleranceMinutes: Integer
  + contains(temperatureC, humidityPct): Boolean
}
}
package "Fleet and Resources [Supporting]" {
class Vehicle <<AggregateRoot>> {
  - id: UUID
  - organizationId: UUID
  - plate: String
  - capacityTons: Decimal
  - enabled: Boolean
  + isAvailable(from, until): Boolean
  + changeCapacity(tons: Decimal): void
  + disable(): void
}
interface IVehicleRepository <<DomainPort>> {
  + find(id): Vehicle
  + save(aggregate: Vehicle): void
}
IVehicleRepository ..> Vehicle : persists root
class Sensor <<Entity>> {
  - id: UUID
  - vehicleId: UUID?
  - serialCode: String
  - enabled: Boolean
  + assign(vehicleId: UUID): void
  + disable(): void
}
class Driver <<AggregateRoot>> {
  - id: UUID
  - organizationId: UUID
  - fullName: String
  - licenseNumber: String
  - enabled: Boolean
  + isAvailable(from, until): Boolean
  + disable(): void
}
interface IDriverRepository <<DomainPort>> {
  + find(id): Driver
  + save(aggregate: Driver): void
}
IDriverRepository ..> Driver : persists root
class FleetAllocation <<AggregateRoot>> {
  - id: UUID
  - shipmentId: UUID
  - vehicleId: UUID
  - driverId: UUID
  - reservedFrom: DateTimeOffset
  - reservedUntil: DateTimeOffset
  - status: String
  - releasedAt: DateTimeOffset?
  + reserve(): void
  + release(at: DateTimeOffset): void
}
interface IFleetAllocationRepository <<DomainPort>> {
  + find(id): FleetAllocation
  + save(aggregate: FleetAllocation): void
}
IFleetAllocationRepository ..> FleetAllocation : persists root
}
package "Alert and Reporting [Supporting]" {
class Alert <<AggregateRoot>> {
  - id: UUID
  - shipmentId: UUID
  - triggerReadingId: Int64?
  - type: AlertType
  - severity: AlertSeverity
  - status: AlertStatus
  - openedAt: DateTimeOffset
  - acknowledgedAt: DateTimeOffset?
  - resolvedAt: DateTimeOffset?
  + acknowledge(action: CorrectiveAction): void
  + resolveWithEvidence(evidence: RecoveryEvidence): void
}
interface IAlertRepository <<DomainPort>> {
  + find(id): Alert
  + save(aggregate: Alert): void
}
IAlertRepository ..> Alert : persists root
class CorrectiveAction <<Entity>> {
  - id: UUID
  - alertId: UUID
  - registeredBy: UUID
  - comment: String
  - notifyClient: Boolean
  - registeredAt: DateTimeOffset
}
class Notification <<AggregateRoot>> {
  - id: UUID
  - userId: UUID
  - shipmentId: UUID
  - alertId: UUID?
  - kind: String
  - createdAt: DateTimeOffset
  - readAt: DateTimeOffset?
  + markRead(at: DateTimeOffset): void
}
interface INotificationRepository <<DomainPort>> {
  + find(id): Notification
  + save(aggregate: Notification): void
}
INotificationRepository ..> Notification : persists root
class Incident <<AggregateRoot>> {
  - id: UUID
  - shipmentId: UUID
  - registeredBy: UUID
  - description: String
  - registeredAt: DateTimeOffset
}
interface IIncidentRepository <<DomainPort>> {
  + find(id): Incident
  + save(aggregate: Incident): void
}
IIncidentRepository ..> Incident : persists root
class ThermalReport <<AggregateRoot>> {
  - id: UUID
  - shipmentId: UUID
  - generatedBy: UUID
  - generatedAt: DateTimeOffset
  - filePath: String
  - summary: JsonSnapshot
  + generateSnapshot(shipment): void
}
interface IThermalReportRepository <<DomainPort>> {
  + find(id): ThermalReport
  + save(aggregate: ThermalReport): void
}
IThermalReportRepository ..> ThermalReport : persists root
class RecoveryEvidence <<ValueObject>> {
  - readingId: Int64
  - recordedAt: DateTimeOffset
  - withinBothRanges: Boolean
  + isValidAfter(openedAt): Boolean
}
}
package "IAM [Generic]" {
class Organization <<AggregateRoot>> {
  - id: UUID
  - name: String
  + rename(name: String): void
}
interface IOrganizationRepository <<DomainPort>> {
  + find(id): Organization
  + save(aggregate: Organization): void
}
IOrganizationRepository ..> Organization : persists root
class UserAccount <<AggregateRoot>> {
  - id: UUID
  - organizationId: UUID
  - email: String
  - passwordHash: String
  - fullName: String
  - role: UserRole
  - preferredLanguage: String
  - enabled: Boolean
  - failedAttempts: Integer
  - lockedUntil: DateTimeOffset?
  + authenticate(password: String): Boolean
  + changePassword(password: String): void
  + updateProfile(name, language): void
}
interface IUserAccountRepository <<DomainPort>> {
  + find(id): UserAccount
  + save(aggregate: UserAccount): void
}
IUserAccountRepository ..> UserAccount : persists root
class PasswordResetToken <<Entity>> {
  - id: UUID
  - userId: UUID
  - tokenHash: String
  - expiresAt: DateTimeOffset
  - usedAt: DateTimeOffset?
  + isValid(at: DateTimeOffset): Boolean
  + markUsed(at: DateTimeOffset): void
}
}
Shipment "1" *-- "1" ThermalRange
Shipment "1" *-- "0..*" ShipmentHistoryEvent
ShipmentMonitoring "1" *-- "1" MonitoredRange
ShipmentMonitoring "1" *-- "0..*" SensorReading
ShipmentMonitoring "1" *-- "0..*" PositionReport
Vehicle "1" *-- "0..1" Sensor
Alert "1" *-- "0..*" CorrectiveAction
Alert ..> RecoveryEvidence : validates local evidence
UserAccount "1" *-- "0..*" PasswordResetToken
Shipment ..> Vehicle : identity reference vehicleId
Shipment ..> Driver : identity reference driverId
Shipment ..> UserAccount : identity reference clientId / coordinatorId
FleetAllocation ..> Shipment : identity reference shipmentId
FleetAllocation ..> Vehicle : identity reference vehicleId
FleetAllocation ..> Driver : identity reference driverId
ShipmentMonitoring ..> Shipment : identity reference shipmentId
Alert ..> Shipment : identity reference shipmentId
Notification ..> UserAccount : identity reference userId
ThermalReport ..> Shipment : identity reference shipmentId
Incident ..> Shipment : identity reference shipmentId
UserAccount ..> Organization : identity reference organizationId
note bottom of Shipment
Valid thermal range and lifecycle transitions.
Application confirms fleet reservation before scheduling.
end note
note bottom of FleetAllocation
Reservation interval cannot overlap an active assignment.
Concurrency must be enforced by the transaction strategy.
end note
note bottom of Alert
Acknowledgement does not prove recovery.
Resolution requires later valid RecoveryEvidence.
end note
@enduml
